#!/usr/bin/env bash
set -Eeuo pipefail

export DEBIAN_FRONTEND=noninteractive

${systemctl_retry_script}

# EC2 starts without an auto-assigned public IPv4 address. Wait for
# Terraform to associate the EIP so that outbound internet access works.
# Instance metadata is local and remains accessible without internet.
for attempt in $(seq 1 120); do
    token="$(curl -fsS --connect-timeout 2 --max-time 5 -X PUT \
        -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' \
        http://169.254.169.254/latest/api/token 2>/dev/null || true)"
    if [[ -n "$token" ]]; then
        eip="$(curl -fsS --connect-timeout 2 --max-time 5 \
            -H "X-aws-ec2-metadata-token: $token" \
            http://169.254.169.254/latest/meta-data/public-ipv4 2>/dev/null || true)"
        [[ -n "$eip" ]] && break
    fi
    sleep 5
done
[[ -n "$eip" ]] || { echo "ERROR: Elastic IP association not visible in EC2 metadata" >&2; exit 1; }

apt-get update
# First-boot unattended upgrades can hold dpkg's lock; wait up to ten minutes.
apt-get -o DPkg::Lock::Timeout=600 install -y python3-venv ca-certificates curl git openssl e2fsprogs util-linux awscli

# Start CloudWatch collection before the long Docker and vLLM setup.
# Terraform manages the destination log groups and their 7-day retention.
cw_agent_deb="$(mktemp --suffix=.deb)"
curl -fSL --retry 5 \
  "https://amazoncloudwatch-agent.s3.amazonaws.com/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb" \
  -o "$cw_agent_deb"
apt-get -o DPkg::Lock::Timeout=600 install -y "$cw_agent_deb"
rm -f "$cw_agent_deb"

mkdir -p /opt/aws/amazon-cloudwatch-agent/etc
cat > /opt/aws/amazon-cloudwatch-agent/etc/fyp-logs.json <<'CLOUDWATCH'
{
  "agent": {
    "region": "${aws_region}"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [{
          "file_path": "/var/log/cloud-init-output.log",
          "log_group_name": "${cloud_init_log_group}",
          "log_stream_name": "{instance_id}"
        }]
      },
      "journald": {
        "collect_list": [{
          "units": ["qwen-vllm.service"],
          "priority": "info",
          "log_group_name": "${vllm_log_group}",
          "log_stream_name": "{instance_id}"
        }]
      }
    }
  }
}
CLOUDWATCH

/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/fyp-logs.json -s


# The AWS Deep Learning AMI already bundles Docker Engine and Compose v2.
# Use the AMI's installation instead of modifying its Docker APT sources.
if ! command -v docker >/dev/null 2>&1; then
    echo "ERROR: Docker is missing from the selected AMI." >&2
    exit 1
fi
if ! docker compose version >/dev/null 2>&1; then
    echo "ERROR: Docker Compose v2 plugin is missing from the selected AMI." >&2
    exit 1
fi

systemctl_retry enable --now docker
if ! docker info >/dev/null 2>&1; then
    echo "ERROR: Docker daemon is not available after startup." >&2
    exit 1
fi

echo "Reusing AMI Docker: $(docker --version)"
echo "Reusing AMI Compose: $(docker compose version)"

install -d -o ubuntu -g ubuntu /opt/qwen-vllm/Script
echo '${serve_script}' | base64 -d | gzip -d > /opt/qwen-vllm/Script/serve_qwen35_vllm.sh
echo '${requirements}' | base64 -d | gzip -d > /opt/qwen-vllm/Script/requirements-vllm.txt
echo '${readiness_script}' | base64 -d | gzip -d > /opt/qwen-vllm/Script/check_vllm_ready.py
echo '${callback_script}' | base64 -d | gzip -d > /opt/qwen-vllm/Script/configure_training_callback.py
echo '${bootstrap_script}' | base64 -d | gzip -d > /opt/qwen-vllm/Script/bootstrap_apps.sh
cat > /usr/local/sbin/bootstrap-fyp-apps <<'FYP_BOOTSTRAP'
#!/usr/bin/env bash
set -Eeuo pipefail

export TRAINING_STATE_MACHINE_ARN="${training_state_machine_arn}"
export TRAINING_CALLBACK_TOKEN_PARAMETER="${training_callback_token_parameter}"
export AWS_REGION="${aws_region}"
exec /opt/qwen-vllm/Script/bootstrap_apps.sh
FYP_BOOTSTRAP
chmod 0755 /usr/local/sbin/bootstrap-fyp-apps /opt/qwen-vllm/Script/bootstrap_apps.sh
chmod 0755 /opt/qwen-vllm/Script/serve_qwen35_vllm.sh
chown ubuntu:ubuntu /opt/qwen-vllm/Script/serve_qwen35_vllm.sh /opt/qwen-vllm/Script/requirements-vllm.txt /opt/qwen-vllm/Script/check_vllm_ready.py

cat > /usr/local/sbin/prepare-llm-storage <<'STORAGE'
#!/usr/bin/env bash
set -Eeuo pipefail

# The Deep Learning AMI initializes the NVMe disk as an LVM volume and
# mounts its ext4 filesystem at /opt/dlami/nvme. Never format the PV directly.
source_mount=/opt/dlami/nvme
target_mount=/mnt/llm-data

if ! mountpoint -q "$source_mount"; then
    echo "ERROR: DLAMI NVMe mount is unavailable at $source_mount" >&2
    exit 1
fi

mkdir -p "$source_mount/llm-data" "$target_mount"
if ! mountpoint -q "$target_mount"; then
    mount --bind "$source_mount/llm-data" "$target_mount"
fi

install -d -o ubuntu -g ubuntu \
    "$target_mount/adapters" \
    "$target_mount/cache" \
    "$target_mount/venv" \
    "$target_mount/bootstrap" \
    "$target_mount/uv-cache" \
    "$target_mount/uv-python" \
    "$target_mount/pip-cache" \
    "$target_mount/xdg-cache"

STORAGE
chmod 0755 /usr/local/sbin/prepare-llm-storage

cat > /etc/systemd/system/llm-storage.service <<'UNIT'
[Unit]
Description=Prepare LLM storage using DLAMI NVMe
Requires=dlami-nvme.service
After=dlami-nvme.service
RequiresMountsFor=/opt/dlami/nvme

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/prepare-llm-storage
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
UNIT

cat > /etc/systemd/system/qwen-vllm.service <<'UNIT'
[Unit]
Description=Qwen3.5-9B vLLM server
Wants=network-online.target
Requires=llm-storage.service
After=network-online.target llm-storage.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/qwen-vllm/Script
Environment=FYP_VLLM_HOST=0.0.0.0
Environment=FYP_VLLM_MAX_MODEL_LEN=8192
Environment=FYP_VLLM_GPU_MEMORY_UTILIZATION=0.90
Environment=FYP_VLLM_MAX_NUM_SEQS=1
Environment=FYP_VLLM_MAX_LORA_RANK=64
Environment=FYP_VLLM_MAX_LORAS=1
Environment=FYP_VLLM_MAX_CPU_LORAS=4
Environment=FYP_LORA_RUNTIME_ENABLED=true
Environment=FYP_LORA_ADAPTER_DIRECTORY=/mnt/llm-data/adapters
Environment=HF_TOKEN_SSM_PARAMETER=${hf_token_parameter}
Environment=HF_TOKEN_SSM_REGION=${aws_region}
Environment=HF_HOME=/mnt/llm-data/cache
Environment=VENV_DIR=/mnt/llm-data/venv
Environment=BOOTSTRAP_VENV=/mnt/llm-data/bootstrap
Environment=UV_CACHE_DIR=/mnt/llm-data/uv-cache
Environment=UV_PYTHON_INSTALL_DIR=/mnt/llm-data/uv-python
Environment=PIP_CACHE_DIR=/mnt/llm-data/pip-cache
Environment=XDG_CACHE_HOME=/mnt/llm-data/xdg-cache
# Optional host configuration and HF read token; keep credentials outside user data.
EnvironmentFile=-/etc/qwen-vllm.env
ExecStart=/opt/qwen-vllm/Script/serve_qwen35_vllm.sh
ExecStartPost=/usr/bin/python3 /opt/qwen-vllm/Script/check_vllm_ready.py
TimeoutStartSec=45min
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
UNIT

# Start host services. A lost systemctl connection must not skip app bootstrap.
systemctl_retry daemon-reload
systemctl_retry enable --now llm-storage.service
systemctl_retry enable --now qwen-vllm.service
# Active is reached only after ExecStartPost checks health, models and runtime APIs.
systemctl_retry is-active --quiet qwen-vllm.service

# Reattach the journal reader after any systemd/journald upgrade during startup.
systemctl_retry restart amazon-cloudwatch-agent.service
systemctl_retry is-active --quiet amazon-cloudwatch-agent.service

# Deploy public frontend/backend repositories after the host services are configured.
/usr/local/sbin/bootstrap-fyp-apps
