#!/usr/bin/env bash
set -Eeuo pipefail

export DEBIAN_FRONTEND=noninteractive

# EC2 starts without an auto-assigned public IPv4 address. Wait for
# Terraform to associate the EIP so that outbound internet access works.
# Instance metadata is local and remains accessible without internet.
for attempt in $(seq 1 120); do
    token="$(curl -fsS --connect-timeout 2 --max-time 5 -X PUT \
        -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' \
        http://169.254.169.254/latest/api/token 2>/dev/null || true)"
    if [[ -n "$token" ]]; then
        eip="$(curl -fsS --connect-timeout 2 --max-time 5 \
            -H "X-aws-ec2-metadata-token: $token" \
            http://169.254.169.254/latest/meta-data/public-ipv4 2>/dev/null || true)"
        [[ -n "$eip" ]] && break
    fi
    sleep 5
done
[[ -n "$eip" ]] || { echo "ERROR: Elastic IP association not visible in EC2 metadata" >&2; exit 1; }

apt-get update
apt-get install -y python3-venv ca-certificates curl git openssl e2fsprogs util-linux

# Start CloudWatch collection before the long Docker and vLLM setup.
# Terraform manages the destination log groups and their 7-day retention.
cw_agent_deb="$(mktemp --suffix=.deb)"
curl -fSL --retry 5 \
  "https://amazoncloudwatch-agent.s3.amazonaws.com/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb" \
  -o "$cw_agent_deb"
dpkg -i "$cw_agent_deb"
rm -f "$cw_agent_deb"

mkdir -p /opt/aws/amazon-cloudwatch-agent/etc
cat > /opt/aws/amazon-cloudwatch-agent/etc/fyp-logs.json <<'CLOUDWATCH'
{
  "agent": {
    "region": "${aws_region}"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [{
          "file_path": "/var/log/cloud-init-output.log",
          "log_group_name": "${cloud_init_log_group}",
          "log_stream_name": "{instance_id}"
        }]
      },
      "journald": {
        "collect_list": [{
          "units": ["qwen-vllm.service"],
          "priority": "info",
          "log_group_name": "${vllm_log_group}",
          "log_stream_name": "{instance_id}"
        }]
      }
    }
  }
}
CLOUDWATCH

/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/fyp-logs.json -s


# The AWS Deep Learning AMI already bundles Docker Engine and Compose v2.
# Use the AMI's installation instead of modifying its Docker APT sources.
if ! command -v docker >/dev/null 2>&1; then
    echo "ERROR: Docker is missing from the selected AMI." >&2
    exit 1
fi
if ! docker compose version >/dev/null 2>&1; then
    echo "ERROR: Docker Compose v2 plugin is missing from the selected AMI." >&2
    exit 1
fi

systemctl enable --now docker
if ! docker info >/dev/null 2>&1; then
    echo "ERROR: Docker daemon is not available after startup." >&2
    exit 1
fi

echo "Reusing AMI Docker: $(docker --version)"
echo "Reusing AMI Compose: $(docker compose version)"

install -d -o ubuntu -g ubuntu /opt/qwen-vllm/Script
echo '${serve_script}' | base64 -d | gzip -d > /opt/qwen-vllm/Script/serve_qwen35_vllm.sh
echo '${requirements}' | base64 -d | gzip -d > /opt/qwen-vllm/Script/requirements-vllm.txt
cat > /usr/local/sbin/bootstrap-fyp-apps <<'FYP_BOOTSTRAP'
#!/usr/bin/env bash
set -Eeuo pipefail

# Bootstraps the two public FYP repositories on an Ubuntu EC2 instance.
# Run as root after Docker Engine and the vLLM service have been started.
umask 077
install -d -m 0755 /opt/fyp

for project in backend frontend; do
    target="/opt/fyp/$project"
    if [[ ! -d "$target/.git" ]]; then
        git clone --depth 1 "https://github.com/FYP-Team-5/$project.git" "$target"
    fi
    if [[ ! -f "$target/.env" ]]; then
        cp "$target/.env.example" "$target/.env"
    fi
    chmod 0600 "$target/.env"
done

set_env() {
    local path="$1" name="$2" value="$3"
    if grep -q "^$name=" "$path"; then
        sed -i "s|^$name=.*|$name=$value|" "$path"
    else
        printf '%s=%s\n' "$name" "$value" >> "$path"
    fi
}

# Read the associated Elastic IP from IMDSv2 (no auto-assigned public IPv4).
token="$(curl --fail --silent --show-error --retry 4 \
    --request PUT http://169.254.169.254/latest/api/token \
    --header 'X-aws-ec2-metadata-token-ttl-seconds: 60')"
public_ip="$(curl --fail --silent --show-error --retry 4 \
    --header "X-aws-ec2-metadata-token: $token" \
    http://169.254.169.254/latest/meta-data/public-ipv4)"

backend_env=/opt/fyp/backend/.env
frontend_env=/opt/fyp/frontend/.env

# Generate unique boot-time secrets; do not store them in Git or Terraform state.
set_env "$backend_env" POSTGRES_PASSWORD "$(openssl rand -hex 24)"
set_env "$backend_env" JWT_SECRET "$(openssl rand -hex 32)"
set_env "$backend_env" STAFF_REGISTRATION_KEY "$(openssl rand -hex 32)"
api_key="$(openssl rand -hex 32)"
set_env "$backend_env" API_KEY "$api_key"
set_env "$backend_env" POSTGRES_PORT "127.0.0.1:5433"
set_env "$backend_env" CORS_ORIGINS "http://$public_ip:3000"
set_env "$backend_env" LLM_URL "http://host.docker.internal:8000/v1/chat/completions"
set_env "$backend_env" LLM_MODEL "qwen35-9b-grading-qlora"

# NEXT_PUBLIC variables are embedded in the frontend image during the build.
set_env "$frontend_env" NEXT_PUBLIC_API_URL "http://$public_ip:8002"
set_env "$frontend_env" NEXT_PUBLIC_GRADING_API_KEY "$api_key"
set_env "$frontend_env" FRONTEND_BIND_IP "0.0.0.0"
set_env "$frontend_env" FRONTEND_PORT "3000"

# This is a demo setup: the frontend embeds its API key in public JavaScript.
# Add an HTTPS proxy and stronger server-side authorization before production.
docker compose --project-directory /opt/fyp/backend up --build -d
docker compose --project-directory /opt/fyp/frontend up --build -d

echo "FYP frontend: http://$public_ip:3000"
echo "FYP backend API: http://$public_ip:8002/health"
FYP_BOOTSTRAP
chmod 0755 /usr/local/sbin/bootstrap-fyp-apps
chmod 0755 /opt/qwen-vllm/Script/serve_qwen35_vllm.sh
chown ubuntu:ubuntu /opt/qwen-vllm/Script/serve_qwen35_vllm.sh /opt/qwen-vllm/Script/requirements-vllm.txt

cat > /usr/local/sbin/prepare-llm-storage <<'STORAGE'
#!/usr/bin/env bash
set -Eeuo pipefail

device=""
for attempt in $(seq 1 30); do
    device="$(lsblk -dn -o NAME,MODEL | awk '$0 ~ /Amazon EC2 NVMe Instance Storage/ { print "/dev/" $1; exit }')"
    [[ -n "$device" ]] && break
    sleep 2
done
[[ -n "$device" ]] || { echo "ERROR: EC2 NVMe instance store was not found" >&2; exit 1; }

if ! blkid -s TYPE -o value "$device" >/dev/null 2>&1; then
    mkfs.ext4 -F "$device"
fi

mkdir -p /mnt/llm-data
if ! mountpoint -q /mnt/llm-data; then
    mount "$device" /mnt/llm-data
fi
install -d -o ubuntu -g ubuntu /mnt/llm-data/cache /mnt/llm-data/venv /mnt/llm-data/bootstrap /mnt/llm-data/uv-cache /mnt/llm-data/uv-python /mnt/llm-data/pip-cache /mnt/llm-data/xdg-cache
STORAGE
chmod 0755 /usr/local/sbin/prepare-llm-storage

cat > /etc/systemd/system/llm-storage.service <<'UNIT'
[Unit]
Description=Mount EC2 NVMe instance store for LLM caches

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/prepare-llm-storage
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
UNIT

cat > /etc/systemd/system/qwen-vllm.service <<'UNIT'
[Unit]
Description=Qwen3.5-9B vLLM server
Wants=network-online.target
Requires=llm-storage.service
After=network-online.target llm-storage.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/qwen-vllm/Script
Environment=VLLM_HOST=0.0.0.0
Environment=VLLM_MAX_MODEL_LEN=8192
Environment=VLLM_GPU_MEMORY_UTILIZATION=0.90
Environment=VLLM_MAX_NUM_SEQS=1
Environment=HF_HOME=/mnt/llm-data/cache
Environment=VENV_DIR=/mnt/llm-data/venv
Environment=BOOTSTRAP_VENV=/mnt/llm-data/bootstrap
Environment=UV_CACHE_DIR=/mnt/llm-data/uv-cache
Environment=UV_PYTHON_INSTALL_DIR=/mnt/llm-data/uv-python
Environment=PIP_CACHE_DIR=/mnt/llm-data/pip-cache
Environment=XDG_CACHE_HOME=/mnt/llm-data/xdg-cache
ExecStart=/opt/qwen-vllm/Script/serve_qwen35_vllm.sh
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now llm-storage.service
systemctl enable --now qwen-vllm.service

# Deploy public frontend/backend repositories after the host services are configured.
/usr/local/sbin/bootstrap-fyp-apps
