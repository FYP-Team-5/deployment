# Copy to /etc/qwen-vllm.env on the serving host (root-owned, mode 0600).
# The systemd service reads this file; backend .env is configured separately.
LORA_PATH=SmuFypTeam5/GradingQlora
LORA_MODEL_NAME=qwen35-9b-grading-qlora
FEEDBACK_LORA_PATH=SmuFypTeam5/feedback
FEEDBACK_LORA_MODEL_NAME=qwen35-9b-feedback-qlora

# Both adapters use Qwen/Qwen3.5-9B. Rank 64 accommodates grading rank 48
# and feedback rank 16. Keep the existing one-request GPU memory settings.
FYP_VLLM_MAX_LORA_RANK=64
FYP_VLLM_MAX_LORAS=1
FYP_VLLM_MAX_CPU_LORAS=4

# Uncomment on the host if either HF repository needs authentication.
# Use a read token with access to both repositories. Never commit the token.
# HF_TOKEN=hf_your_read_token

# To serve local adapter files, replace the relevant *_LORA_PATH/LORA_PATH
# above with an absolute directory containing adapter_config.json and weights.
