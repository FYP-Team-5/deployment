{
  "StartAt": "Initialize",
  "TimeoutSeconds": 68400,
  "States": {
    "Prepare": {
      "Type": "Task",
      "Resource": "${lambda_arn}",
      "Parameters": {
        "action": "prepare",
        "execution_id.$": "$.execution_id"
      },
      "ResultPath": "$.job",
      "Next": "ShouldTrain",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailAndStop"
        }
      ],
      "TimeoutSeconds": 620
    },
    "ShouldTrain": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.job.train",
          "BooleanEquals": true,
          "Next": "StartGPU"
        }
      ],
      "Default": "Skipped"
    },
    "Skipped": {
      "Type": "Succeed"
    },
    "StartGPU": {
      "Type": "Task",
      "Resource": "${lambda_arn}",
      "Parameters": {
        "action": "start",
        "job.$": "$.job"
      },
      "ResultPath": "$.start",
      "Next": "Init",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailAndStop"
        }
      ],
      "TimeoutSeconds": 620,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "Init": {
      "Type": "Pass",
      "Result": 0,
      "ResultPath": "$.attempt",
      "Next": "WaitBoot"
    },
    "WaitBoot": {
      "Type": "Wait",
      "Seconds": 45,
      "Next": "Launch"
    },
    "Launch": {
      "Type": "Task",
      "Resource": "${lambda_arn}",
      "Parameters": {
        "action": "launch",
        "job.$": "$.job",
        "attempt.$": "$.attempt"
      },
      "ResultPath": "$.launch",
      "Next": "Ready",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailAndStop"
        }
      ],
      "TimeoutSeconds": 620
    },
    "Ready": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.launch.ready",
          "BooleanEquals": true,
          "Next": "WaitTraining"
        },
        {
          "Variable": "$.launch.attempt",
          "NumericGreaterThanEquals": 20,
          "Next": "BootTimeout"
        }
      ],
      "Default": "NextAttempt"
    },
    "NextAttempt": {
      "Type": "Pass",
      "Parameters": {
        "job.$": "$.job",
        "attempt.$": "$.launch.attempt",
        "execution_id.$": "$.execution_id"
      },
      "Next": "WaitBoot"
    },
    "WaitTraining": {
      "Type": "Wait",
      "Seconds": 90,
      "Next": "Poll"
    },
    "Poll": {
      "Type": "Task",
      "Resource": "${lambda_arn}",
      "Parameters": {
        "action": "poll",
        "command_id.$": "$.launch.command_id",
        "job.$": "$.job"
      },
      "ResultPath": "$.poll",
      "Next": "Finished",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailAndStop"
        }
      ],
      "TimeoutSeconds": 620,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "Finished": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.poll.done",
          "BooleanEquals": true,
          "Next": "Complete"
        }
      ],
      "Default": "WaitTraining"
    },
    "Complete": {
      "Type": "Task",
      "Resource": "${lambda_arn}",
      "Parameters": {
        "action": "complete",
        "job.$": "$.job"
      },
      "ResultPath": "$.candidate",
      "Next": "StopGPU",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailAndStop"
        }
      ],
      "TimeoutSeconds": 620,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "StopGPU": {
      "Type": "Task",
      "Resource": "${lambda_arn}",
      "Parameters": {
        "action": "stop",
        "execution_id.$": "$.execution_id"
      },
      "ResultPath": "$.result",
      "End": true,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailAndStop"
        }
      ],
      "TimeoutSeconds": 620,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ]
    },
    "FailAndStop": {
      "Type": "Task",
      "Resource": "${lambda_arn}",
      "Parameters": {
        "action": "fail",
        "execution_id.$": "$.execution_id",
        "error.$": "$.error"
      },
      "ResultPath": "$.result",
      "Next": "Failed",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Failed"
        }
      ],
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 4,
          "BackoffRate": 2
        }
      ],
      "TimeoutSeconds": 620
    },
    "Failed": {
      "Type": "Fail",
      "Error": "NightlyTrainingFailed"
    },
    "Initialize": {
      "Type": "Pass",
      "Parameters": {
        "execution_id.$": "$$.Execution.Id"
      },
      "Next": "Prepare"
    },
    "BootTimeout": {
      "Type": "Pass",
      "Result": {
        "Error": "SSMReadinessTimeout"
      },
      "ResultPath": "$.error",
      "Next": "FailAndStop"
    }
  }
}
