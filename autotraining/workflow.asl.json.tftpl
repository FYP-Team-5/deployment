{"StartAt":"Prepare","TimeoutSeconds":68400,"States":{"Prepare":{"Type":"Task","Resource":"${lambda_arn}","Parameters":{"action":"prepare"},"ResultPath":"$.job","Next":"ShouldTrain","Catch":[{"ErrorEquals":["States.ALL"],"Next":"Failed"}]},"ShouldTrain":{"Type":"Choice","Choices":[{"Variable":"$.job.train","BooleanEquals":true,"Next":"StartGPU"}],"Default":"Skipped"},"Skipped":{"Type":"Succeed"},"StartGPU":{"Type":"Task","Resource":"${lambda_arn}","Parameters":{"action":"start"},"ResultPath":"$.start","Next":"Init","Catch":[{"ErrorEquals":["States.ALL"],"ResultPath":"$.error","Next":"FailAndStop"}]},"Init":{"Type":"Pass","Result":0,"ResultPath":"$.attempt","Next":"WaitBoot"},"WaitBoot":{"Type":"Wait","Seconds":45,"Next":"Launch"},"Launch":{"Type":"Task","Resource":"${lambda_arn}","Parameters":{"action":"launch","job.$":"$.job","attempt.$":"$.attempt"},"ResultPath":"$.launch","Next":"Ready","Catch":[{"ErrorEquals":["States.ALL"],"ResultPath":"$.error","Next":"FailAndStop"}]},"Ready":{"Type":"Choice","Choices":[{"Variable":"$.launch.ready","BooleanEquals":true,"Next":"WaitTraining"},{"Variable":"$.launch.attempt","NumericGreaterThanEquals":20,"Next":"FailAndStop"}],"Default":"NextAttempt"},"NextAttempt":{"Type":"Pass","InputPath":"$.launch.attempt","ResultPath":"$.attempt","Next":"WaitBoot"},"WaitTraining":{"Type":"Wait","Seconds":90,"Next":"Poll"},"Poll":{"Type":"Task","Resource":"${lambda_arn}","Parameters":{"action":"poll","command_id.$":"$.launch.command_id"},"ResultPath":"$.poll","Next":"Finished","Catch":[{"ErrorEquals":["States.ALL"],"ResultPath":"$.error","Next":"FailAndStop"}]},"Finished":{"Type":"Choice","Choices":[{"Variable":"$.poll.done","BooleanEquals":true,"Next":"Complete"}],"Default":"WaitTraining"},"Complete":{"Type":"Task","Resource":"${lambda_arn}","Parameters":{"action":"complete","job.$":"$.job"},"ResultPath":"$.candidate","Next":"StopGPU","Catch":[{"ErrorEquals":["States.ALL"],"ResultPath":"$.error","Next":"FailAndStop"}]},"StopGPU":{"Type":"Tas